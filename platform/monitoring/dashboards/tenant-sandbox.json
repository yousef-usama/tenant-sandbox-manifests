{
  "title": "Tenant Sandbox",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "row",
      "title": "System",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Pod Restarts By Namespace",
      "targets": [
        {
          "expr": "sum by (namespace) (increase(kube_pod_container_status_restarts_total[5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 }
    },
    {
      "type": "timeseries",
      "title": "Node CPU Usage",
      "targets": [
        {
          "expr": "sum(rate(node_cpu_seconds_total{mode!='idle'}[5m])) by (instance)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "type": "row",
      "title": "Business",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Votes Per Second By Tenant",
      "targets": [
        {
          "expr": "sum by (tenant) (rate(feedback_votes_total[1m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 }
    },
    {
      "type": "timeseries",
      "title": "p95 Latency By Tenant",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (tenant, le) (rate(feedback_api_request_duration_seconds_bucket[5m])))"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 }
    },
    {
      "type": "timeseries",
      "title": "Unique Voters By Tenant",
      "targets": [
        {
          "expr": "feedback_unique_voters"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 }
    }
  ]
}

